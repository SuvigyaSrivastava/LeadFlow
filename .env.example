# ---------------------------------------------------------------------------
# LeadFlow environment. Copy to `.env` and adjust:  cp .env.example .env
# Every variable below has a safe default for local development.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker compose and the backend) -------------------
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# SQLAlchemy URL for running the backend OUTSIDE docker (localhost).
# Inside docker compose the URL is assembled from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow

# --- Backend ---------------------------------------------------------------
# IANA timezone used to decide "due today" / "overdue" and to interpret
# follow-up times that arrive without an offset.
APP_TIMEZONE=Asia/Kolkata
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend --------------------------------------------------------------
# Base URL of the API as seen from the BROWSER.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: AI Conversation Brief ---------------------------------------
# AI_PROVIDER:
#   demo       (default) rule-based brief built from your notes, clearly labelled
#              as demo mode. No model is called and no data leaves your machine.
#   anthropic  Anthropic Messages API. Requires AI_API_KEY.
#   openai     OpenAI-compatible Chat Completions API. Requires AI_API_KEY.
#   none       Feature reports "unavailable".
AI_PROVIDER=demo
AI_API_KEY=
# Leave empty to use the provider default (see backend/app/core/config.py).
AI_MODEL=
# Only for AI_PROVIDER=openai with a compatible gateway.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
